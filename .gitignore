# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
temp/
*.tmp
*.temp

# Generated outputs (play_mosaic --save)
outputs/

# 영상별 데이터는 data/<title>/ 에 모은다.
# 원본 모자이크, 여백을 없앤 모자이크 / 카메라 영상 (용량이 큼)
# 받은 뒤 python scripts/00_prepare_video.py <title> 로 다시 만든다 (raw 필요).
data/raw_video/
data/*/mosaic.mp4
data/*/mosaic.tmp.mp4
data/*/cams/
data/*/content.jsonl
data/*/content.tmp.jsonl

# YOLO 모델 가중치 (용량이 커서 제외, ultralytics로 다시 받을 수 있음)
*.pt

# 백업 압축 파일
*.zip

# YOLO 결과 bbox (영상 1분에 약 20MB라 GitHub 100MB 제한을 넘기 쉬움)
# 받은 뒤 python scripts/01_detect_vehicles.py <title> 로 다시 만든다.
data/*/detections.jsonl
data/*/detections.jsonl.tmp

# 커밋 대상:
#   data/<title>/metadata.json, gate_log.json
#   config/calibration/        카메라 calibration
#   data/maps/                 BEV 지도, 주차 구역

# 웹 비밀 키 (커밋 금지)
web/.secret-key

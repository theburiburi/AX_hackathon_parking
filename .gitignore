# Generated outputs (play_mosaic --save)
outputs/

# 영상: 원본 모자이크(data/videos/raw/)와 전처리로 분리한 카메라 영상
data/videos/

# YOLO 모델 가중치 (용량이 커서 제외, ultralytics로 다시 받을 수 있음)
*.pt

# 백업 압축 파일
*.zip

# YOLO 결과 bbox (영상 1분에 약 20MB라 GitHub 100MB 제한을 넘기 쉬움)
# 받은 뒤 python scripts/preprocess.py <title> 로 다시 만든다.
data/detections/*/detections.jsonl

# 커밋 대상:
#   data/detections/<title>/metadata.json
#   config/calibration/        카메라 calibration
#   data/maps/                 BEV 지도, 주차 구역
